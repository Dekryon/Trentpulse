# From Tiger Data: Service > Connect > connection string (keep ?sslmode=require)
DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Optional: Google AI Studio key for the Gemini tips. Without it, tips are rule-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3001
# The front end address, for CORS (comma separated)
CORS_ORIGIN=http://localhost:5173
